<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_ticket_user_own" model="ir.rule">
            <field name="name">User: Own Tickets Only</field>
            <field name="model_id" ref="model_hr_attendance_ticket"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ticket_user'))]"/>
        </record>

        <record id="rule_ticket_officer_all" model="ir.rule">
            <field name="name">Officer: All Tickets Except Others Drafts</field>
            <field name="model_id" ref="model_hr_attendance_ticket"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('state', '!=', 'draft')]</field>
            <field name="groups" eval="[(4, ref('group_ticket_officer'))]"/>
        </record>

        <record id="rule_attendance_ticket_multi_company" model="ir.rule">
            <field name="name">Attendance Ticket Multi-Company</field>
            <field name="model_id" ref="model_hr_attendance_ticket"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('employee_id.company_id', '=', False), ('employee_id.company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>