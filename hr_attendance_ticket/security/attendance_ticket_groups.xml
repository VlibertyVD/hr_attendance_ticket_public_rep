<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record model="ir.module.category" id="res_groups_privilege_parking_condo">
            <field name="name">Attendance Tickets</field>
            <field name="sequence">20</field>
            <field name="parent_id" ref="base.module_category_human_resources"/>
        </record>

        <record id="group_ticket_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="res_groups_privilege_parking_condo"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can create and read own attendance tickets.</field>
        </record>

        <record id="group_ticket_officer" model="res.groups">
            <field name="name">Officer</field>
            <field name="category_id" ref="res_groups_privilege_parking_condo"/>
            <field name="implied_ids" eval="[(4, ref('hr_attendance_ticket.group_ticket_user'))]"/>
            <field name="comment">Can approve tickets for all users.</field>
        </record>

        <record id="group_ticket_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="res_groups_privilege_parking_condo"/>
            <field name="implied_ids" eval="[(4, ref('hr_attendance_ticket.group_ticket_officer'))]"/>
            <field name="comment">Full access to attendance tickets module.</field>
        </record>

    </data>
</odoo>