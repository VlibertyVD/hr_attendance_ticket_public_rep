<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Attendance Tickets -->
        <record id="seq_hr_attendance_ticket" model="ir.sequence">
            <field name="name">Attendance Ticket Sequence</field>
            <field name="code">hr.attendance.ticket</field>
            <field name="prefix">AT-%(year)s%(month)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>