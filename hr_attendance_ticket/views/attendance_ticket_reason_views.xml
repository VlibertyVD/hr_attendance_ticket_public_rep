<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_attendance_ticket_reason_list" model="ir.ui.view">
            <field name="name">hr.attendance.ticket.reason.list</field>
            <field name="model">hr.attendance.ticket.reason</field>
            <field name="arch" type="xml">
                <list string="Ticket Reasons">
                    <field name="name"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <record id="view_attendance_ticket_reason_form" model="ir.ui.view">
            <field name="name">hr.attendance.ticket.reason.form</field>
            <field name="model">hr.attendance.ticket.reason</field>
            <field name="arch" type="xml">
                <form string="Ticket Reason">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        
                        <div class="oe_title">
                            <label for="name" string="Reason Name"/>
                            <h1>
                                <field name="name" placeholder="e.g. Forgot to Check-In..."/>
                            </h1>
                        </div>
                        <group>
                            <field name="description" placeholder="Internal notes or description about this reason..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_attendance_ticket_reason" model="ir.actions.act_window">
            <field name="name">Ticket Reasons</field>
            <field name="res_model">hr.attendance.ticket.reason</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new reason for attendance adjustment tickets!
                </p>
                <p>
                    These reasons will be available for employees to select when submitting a ticket.
                </p>
            </field>
        </record>



    </data>
</odoo>