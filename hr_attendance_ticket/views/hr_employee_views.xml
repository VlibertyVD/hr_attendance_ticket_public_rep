<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_attendance_ticket_from_employee" model="ir.actions.act_window">
            <field name="name">Attendance Tickets</field>
            <field name="res_model">hr.attendance.ticket</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('employee_id', '=', active_id)]</field>

            <field name="context">{'default_employee_id': active_id}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create the first attendance ticket for this employee.
                </p>
            </field>
        </record>

        <record id="view_employee_form_inherit_attendance_ticket" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.attendance.ticket</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">

                <div name="button_box" position="inside">
                    <button name="%(action_attendance_ticket_from_employee)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-ticket"
                            groups="hr_attendance_ticket.group_ticket_user">
                        <field name="attendance_ticket_count" widget="statinfo" string="Tickets"/>
                    </button>
                </div>
            </field>
        </record>

    </data>
</odoo>